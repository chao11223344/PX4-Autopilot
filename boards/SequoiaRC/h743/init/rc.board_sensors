#!/bin/sh
#
# board specific sensors init
#------------------------------------------------------------------------------

board_adc start

# Internal SPI1 IMU: ICM-42688P or ICM-42605
if ! icm42688p -R 0 -b 1 -s start
then
	icm42605 -R 0 -b 1 -s start
fi

# Internal SPI4 IMU: ICM-42688P or ICM-42605
if ! icm42688p -R 2 -b 4 -s start
then
	icm42605 -R 2 -b 4 -s start
fi

# Internal baro
spl06 -I -a 0x76 start

# External mag
#qmc5883l -X start -a 13
